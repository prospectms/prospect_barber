# ════════════════════════════════════════════════════════════════════
#  Prospect BarberHub — Variáveis de Ambiente
#  Copie este arquivo para .env e preencha os valores.
#  NUNCA commite o .env real no repositório.
# ════════════════════════════════════════════════════════════════════

# ── Ambiente ──────────────────────────────────────────────────────
# "production" | "development"
FLASK_CONFIG=production

# ── Segurança ─────────────────────────────────────────────────────
# OBRIGATÓRIO em produção. Gere com:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# ── Banco de dados ────────────────────────────────────────────────
# SQLite (padrão para ambiente local / VPS inicial)
DATABASE_URL=sqlite:////var/www/barberhub/database.db

# PostgreSQL (recomendado para produção com múltiplos acessos)
# Instale psycopg2-binary e descomente a linha abaixo:
# DATABASE_URL=postgresql://barberhub:senha_forte@localhost:5432/barberhub

# ── Uploads ───────────────────────────────────────────────────────
# Tamanho máximo por arquivo em bytes (padrão: 5 MB)
MAX_CONTENT_LENGTH=5242880

# ── Asaas (gateway de pagamento, Fase 3) ─────────────────────────────
# Sandbox: https://api-sandbox.asaas.com/v3 · Produção: https://api.asaas.com/v3
ASAAS_API_BASE_URL=https://api-sandbox.asaas.com/v3
# Gerado em Asaas > Integrações > Chaves de API
ASAAS_API_KEY=
# Mesmo valor configurado em Asaas > Configurações > Webhooks (token de
# autenticação) — endpoint recebedor: POST /webhooks/asaas
ASAAS_WEBHOOK_TOKEN=

# ── Job diário de downgrade por inadimplência (Fase 3) ───────────────
# Gere com: python -c "import secrets; print(secrets.token_hex(32))"
# Mesmo valor usado no crontab que chama POST /internal/downgrade-inadimplentes
# (header X-Internal-Token) — ver DEPLOY.md.
INTERNAL_JOB_TOKEN=
